# -------------------------------------------------------
# Quanton — Multi-Agent Financial Analyser
# Copy this file to .env and fill in the values.
# -------------------------------------------------------

# ── LLM Provider (choose one) ───────────────────────────
# OpenAI (recommended for best results)
OPENAI_API_KEY=your_openai_api_key_here
MODEL=gpt-4o-mini

# Anthropic Claude (alternative)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# MODEL=anthropic/claude-3-5-sonnet-20241022

# Local Ollama (free, requires Ollama running locally)
# MODEL=ollama/llama3.1

# ── SEC API ─────────────────────────────────────────────
# Get a free key at https://sec-api.io
SEC_API_API_KEY=your_sec_api_key_here

# ── Optional: Serper (web search) ───────────────────────
# Get a free key at https://serper.dev
# SERPER_API_KEY=your_serper_api_key_here
